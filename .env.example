# Copy to backend/.env for local (non-Docker) runs, or export before `docker compose up`.
# No secrets are required to run locally. Never commit a real .env.

PORT=4000
CORS_ORIGINS=http://localhost:5173

# --- Product data source ---
FAKESTORE_BASE_URL=https://fakestoreapi.com
CATALOG_CACHE_TTL_SECONDS=300
PRODUCT_SOURCE_TIMEOUT_MS=5000
CURRENCY=USD

# --- Merchandising ---
# The 5 hand-picked "top rated" products shown on the home page (Fake Store ids 1-20).
FEATURED_PRODUCT_IDS=1,5,9,13,17
# How many top rated products head each category page.
CATEGORY_TOP_RATED_COUNT=3

# --- Email ---
# smtp    -> send via SMTP (Mailpit locally: docker compose up mailpit)
# console -> log the email instead of sending (no mail server needed)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SALES_INBOX=sales@example.com
MAIL_FROM=Catalogue <no-reply@example.com>

# Max enquiries per IP per minute (0 disables)
ENQUIRY_RATE_LIMIT_PER_MINUTE=5
